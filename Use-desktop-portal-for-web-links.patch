+    /** Open external links through the desktop portal when running in Flatpak. */
+    public static void browse(URI uri) throws java.io.IOException {
+        if (new java.io.File("/.flatpak-info").isFile()) {
+            new ProcessBuilder("/usr/bin/xdg-open", uri.toString()).start();
+        } else {
+            Desktop.getDesktop().browse(uri);
         }
     }
 
